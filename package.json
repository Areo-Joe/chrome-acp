{
  "name": "chrome-acp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "pnpm --filter @chrome-acp/extension run dev",
    "build": "pnpm run build:web && pnpm run build:extension && pnpm run build:proxy",
    "build:extension": "pnpm --filter @chrome-acp/extension run build",
    "build:proxy": "pnpm --filter @chrome-acp/proxy-server run build",
    "build:web": "pnpm --filter @chrome-acp/web-client run build",
    "build:docs": "pnpm --filter @chrome-acp/docs run build"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.7.0"
  }
}
